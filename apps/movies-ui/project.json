{
  "name": "movies-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/movies-ui",
  "projectType": "application",
  "tags": ["type:app", "scope:movies", "platform:web"],
  "targets": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "default",
        "^default",
        { "externalDependencies": ["next"] },
        { "dependentTasksOutputFiles": "**/*.d.ts", "transitive": true }
      ],
      "outputs": [
        "{workspaceRoot}/apps/movies-ui/.next/!(cache)/**/*",
        "{workspaceRoot}/apps/movies-ui/.next/!(cache)"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/movies-ui",
        "command": "next build --webpack"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/movies-ui",
        "command": "PORT=${UI_PORT:-3000} next dev"
      },
      "parallelism": true,
      "continuous": true
    }
  }
}
